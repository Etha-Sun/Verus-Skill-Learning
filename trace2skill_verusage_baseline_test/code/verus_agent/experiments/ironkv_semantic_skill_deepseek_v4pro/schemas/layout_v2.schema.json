{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "root", "references", "layout_notes"],
  "properties": {
    "status": {"const": "candidate_unvalidated"},
    "root": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "description", "core_procedures", "consultation_workflow", "safety_and_stopping_rules"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "core_procedures": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["title", "when", "steps", "check"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "when": {"type": "string", "minLength": 1},
              "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "check": {"type": "string", "minLength": 1}
            }
          }
        },
        "consultation_workflow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "safety_and_stopping_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "references": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["filename", "title", "consult_when", "do_not_consult_when", "skill_ids"],
        "properties": {
          "filename": {"type": "string", "pattern": "^[a-z0-9_]+\\.md$"},
          "title": {"type": "string", "minLength": 1},
          "consult_when": {"type": "string", "minLength": 1},
          "do_not_consult_when": {"type": "string", "minLength": 1},
          "skill_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^verus_global_[0-9]{3}$"}}
        }
      }
    },
    "layout_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
