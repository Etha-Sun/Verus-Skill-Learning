%%{init: {"theme": "base", "themeCSS": "svg { background-color: #FFFFFF; }", "themeVariables": {"background": "#FFFFFF", "primaryTextColor": "#111827", "lineColor": "#374151", "fontFamily": "Arial, sans-serif"}}}%%
flowchart TB
    tasks["Four frozen task roles<br/>3 shared comparison tasks + 1 branch-specific hard case"]
    h0["Matched H0 collection<br/>Standard Codex prompt; 1 high-fidelity trace per task"]
    tasks --> h0

    subgraph token_ws["Objective 1: Token-cost workspace"]
        direction TB
        token_copy["Copy 4 matched H0 traces"]
        token_meta["Token meta-agent<br/>1 Codex call analyzes the prior round<br/>and proposes 3 skills"]
        token_skills["3 skills specialized for token cost"]
        token_runs["3 × 4 = 12 Codex agentic traces"]
        token_eval["Record complete usage, exposed reasoning metadata,<br/>tool tokens, and verifier-safe success; compute ETtS"]
        token_compare["Compare best and worst mean ETtS<br/>while retaining all 12 outcomes"]
        token_copy --> token_meta --> token_skills --> token_runs --> token_eval --> token_compare
        token_compare -. "Next-round reflection and new skills" .-> token_meta
    end

    subgraph small_ws["Objective 2: Small-model-benefit workspace"]
        direction TB
        small_copy["Copy 4 matched H0 traces"]
        small_meta["Small-model meta-agent<br/>1 Codex call analyzes the prior round<br/>and proposes 3 skills"]
        small_skills["3 skills specialized for small-model performance"]
        small_runs["3 × 4 = 12 small-model agentic trajectories<br/>Parallel API runs; at most 120 model turns if max_iters = 10"]
        small_eval["Record Verus/Lynette outcomes,<br/>provider tokens, and API turns"]
        small_compare["Compare best and worst mean performance<br/>while retaining all 12 outcomes"]
        small_copy --> small_meta --> small_skills --> small_runs --> small_eval --> small_compare
        small_compare -. "Next-round reflection and new skills" .-> small_meta
    end

    subgraph ig_ws["Objective 3: Full-proof InfoGain workspace"]
        direction TB
        ig_copy["Copy 4 matched H0 traces"]
        ig_meta["InfoGain meta-agent<br/>1 Codex call analyzes the prior round<br/>and proposes 3 skills"]
        ig_skills["3 skills specialized for full-proof InfoGain"]
        ig_runs["3 × 4 = 12 Codex agentic traces<br/>Freeze pre-summary, solve, then emit post terminal-repair summary"]
        ig_score["Frozen local small model with exact teacher forcing<br/>Round 1: 4 cached H0 + 12 pre + 12 post = 28 score sequences<br/>Later rounds: reuse H0 and score 24 new sequences"]
        ig_compare["Compute 12 paired pre/post InfoGain values<br/>compare best and worst means, and retain all outcomes"]
        ig_copy --> ig_meta --> ig_skills --> ig_runs --> ig_score --> ig_compare
        ig_compare -. "Next-round reflection and new skills" .-> ig_meta
    end

    h0 --> token_copy
    h0 --> small_copy
    h0 --> ig_copy

    token_compare --> totals
    small_compare --> totals
    ig_compare --> totals
    totals["Invocation ledger<br/>Round 1 including H0: 31 Codex traces + 12 small-model API trajectories + 28 local score sequences<br/>Each later round: 27 Codex traces + 12 small-model API trajectories + 24 local score sequences<br/>Final synthesis: 3 additional Codex meta-agent calls"]

    classDef input fill:#ECFDF5,stroke:#059669,stroke-width:2px,color:#111827;
    classDef token fill:#EFF6FF,stroke:#2563EB,stroke-width:2px,color:#111827;
    classDef small fill:#F5F3FF,stroke:#7C3AED,stroke-width:2px,color:#111827;
    classDef ig fill:#FFF7ED,stroke:#EA580C,stroke-width:2px,color:#111827;
    classDef output fill:#F9FAFB,stroke:#374151,stroke-width:2px,color:#111827;

    class tasks,h0 input;
    class token_copy,token_meta,token_skills,token_runs,token_eval,token_compare token;
    class small_copy,small_meta,small_skills,small_runs,small_eval,small_compare small;
    class ig_copy,ig_meta,ig_skills,ig_runs,ig_score,ig_compare ig;
    class totals output;
