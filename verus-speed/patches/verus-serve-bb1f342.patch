+/// Resident mode: verify one request per stdin line, {"cwd": ..., "args": [...]},
+/// and end each with a sentinel line carrying the exit code. Keeps the process,
+/// the loaded rustc library and (with VERUS_IMPORT_CACHE) imported VIR alive.
+fn serve(program: String) {
+    use std::io::{BufRead, Write};
+    const SENTINEL: &str = "\x1eVERUS-SERVE-DONE ";
+    let stdin = std::io::stdin();
+    for line in stdin.lock().lines() {
+        let Ok(line) = line else { break };
+        if line.trim().is_empty() {
+            continue;
+        }
+        let rc = match serde_json::from_str::<serde_json::Value>(&line) {
+            Err(_) => 2,
+            Ok(req) => {
+                let cwd = req["cwd"].as_str().unwrap_or(".").to_string();
+                let mut argv = vec![program.clone()];
+                if let Some(a) = req["args"].as_array() {
+                    argv.extend(a.iter().filter_map(|x| x.as_str().map(String::from)));
+                }
+                if std::env::set_current_dir(&cwd).is_err() {
+                    2
+                } else {
+                    std::panic::catch_unwind(|| verus_main(argv)).unwrap_or(101)
+                }
+            }
+        };
+        let _ = std::io::stderr().flush();
+        println!("{}{{\"rc\":{}}}", SENTINEL, rc);
+        let _ = std::io::stdout().flush();
+    }
+}
