{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "groups", "unresolved_conflicts"],
  "properties": {
    "status": {"const": "candidate_unvalidated"},
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "title", "member_candidate_keys", "merge_rationale"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^global_group_[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "member_candidate_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "merge_rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "unresolved_conflicts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
