{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "level", "batch_id", "provisional_families"],
  "properties": {
    "status": {"const": "candidate_unvalidated"},
    "level": {"type": "integer", "minimum": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "provisional_families": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["node_id", "title", "observable_trigger", "missing_bridge", "mechanism_summary", "boundary", "source_node_ids"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "observable_trigger": {"type": "string", "minLength": 1},
          "missing_bridge": {"type": "string", "minLength": 1},
          "mechanism_summary": {"type": "string", "minLength": 1},
          "boundary": {"type": "string", "minLength": 1},
          "source_node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
