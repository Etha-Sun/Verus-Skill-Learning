# Select one data source available on this machine. Do not commit local paths.
VERUS_SKILL_DATA_ROOT=/absolute/path/to/your/data-source
VERUS_SKILL_RUN_ROOT=/absolute/path/to/your/run-output
# Use legacy for a root containing all_batch_results-cyy-* directly;
# use versioned for a root containing verusage-batch-v1/ and handsoff-v1/.
VERUS_SKILL_DATA_LAYOUT=legacy

# Tool locations used by the autonomous Codex benchmark actor.
COPILOT_BIN=copilot
VERUS_BIN=verus
LYNETTE_BIN=lynette

# GLM benchmark actor (Z.AI general OpenAI-compatible endpoint).
# Put the real key only in .env; never commit it.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Reviewed Codex model catalog used as the template for bridge-backed actors.
SKILLOPT_MODEL_CATALOG_PATH=/absolute/path/to/reviewed/models.json

# Actor-task concurrency. Use 20 for remote APIs; keep local Qwen at 4.
SKILLOPT_TEST_WORKERS=4

# Vendored Verus Trace2Skill producer. Keep analyzed records and the real key local.
TRACE2SKILL_RECORDS_PATH=/absolute/path/to/combined_records.json
TRACE2SKILL_MODEL=deepseek-v4-pro
TRACE2SKILL_BASE_URL=https://api.deepseek.com
TRACE2SKILL_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

# Optional external dependency for atlas-verusage-reproduction/.
ATLAS_ROOT=/absolute/path/to/ATLAS
