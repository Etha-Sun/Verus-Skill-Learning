{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["abstain_threshold", "max_cards", "cards"],
  "properties": {
    "abstain_threshold": {"type": "integer", "const": 2},
    "max_cards": {"type": "integer", "const": 12},
    "cards": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "project",
          "error_families",
          "positive_scope",
          "negative_scope",
          "triggers",
          "guidance",
          "support"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "project": {
            "type": "string",
            "enum": ["any", "anvil", "ironkv"]
          },
          "error_families": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "positive_scope": {"type": "string"},
          "negative_scope": {"type": "string"},
          "triggers": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string"}
          },
          "guidance": {"type": "string"},
          "support": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["task_id", "verifier_label"],
              "properties": {
                "task_id": {"type": "string"},
                "verifier_label": {
                  "type": "string",
                  "enum": ["solved", "failed"]
                }
              }
            }
          }
        }
      }
    }
  }
}
